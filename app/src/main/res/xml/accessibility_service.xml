<?xml version="1.0" encoding="utf-8"?>
<!-- ZeroOS's Accessibility service (Step 4.2). Reads no screen content: it only learns which app's window came to
     the front. By default only ZeroOS's own events; wellbeing widens packageNames at runtime to just the apps it
     watches outside ZeroOS (F8.7, F8.16, D-023). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100"
    android:packageNames="com.zeroos.launcher"
    tools:ignore="UnusedAttribute" />
