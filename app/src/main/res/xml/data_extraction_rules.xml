<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup and device transfer on Android 12+ (F13.3): only settings; logs stay on the device (NFR-S5). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/launcher_settings.json" />
        <include domain="sharedpref" path="diagnostics.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/launcher_settings.json" />
        <include domain="sharedpref" path="diagnostics.xml" />
    </device-transfer>
</data-extraction-rules>
