      "light": "feature/focus/src/test/screenshots/com.zeroos.feature.focus.FocusScreensTest.step4_5_pickerLightScreenshot.png" },
    { "key": "pause", "src": "feature/wellbeing/src/test/screenshots/com.zeroos.feature.wellbeing.StopScreensTest.step4_3_pauseScreenshot.png",
      "light": "feature/wellbeing/src/test/screenshots/com.zeroos.feature.wellbeing.StopScreensTest.step4_3_pauseLightScreenshot.png" },
    { "key": "shorts", "src": "feature/wellbeing/src/test/screenshots/com.zeroos.feature.wellbeing.ShortFormScreenTest.step6_3_shortFormScreenshot.png",
