{
  "siteUrl": "https://zeroos-jade.vercel.app",
  "applicationCategory": "UtilitiesApplication",
  "releasesApi": "https://api.github.com/repos/iamabhinav-dev/ZeroOS/releases?per_page=50",
  "releasesPage": "https://github.com/iamabhinav-dev/ZeroOS/releases",
  "repoPage": "https://github.com/iamabhinav-dev/ZeroOS",
  "docsBase": "https://github.com/iamabhinav-dev/ZeroOS/blob/main/",
  "apkSuffix": "-release.apk",
  "channels": [
    {
      "id": "stable",
      "prerelease": false,
      "tagPattern": "^v[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    {
      "id": "beta",
      "prerelease": true,
      "tagPattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-(beta|rc)"
    },
    {
      "id": "early",
      "retireWhen": "stable",
      "tagPattern": "^v0\\.[0-9]+\\.[0-9]+"
    }
  ],
  "docs": [
    { "key": "readme", "path": "README.md" },
    { "key": "license", "path": "LICENSE" },
    { "key": "notices", "path": "THIRD_PARTY_NOTICES.md" },
    { "key": "changelog", "path": "CHANGELOG.md" }
  ],
  "screens": [
